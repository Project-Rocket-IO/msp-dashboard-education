# Django Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,rocket-command.com,*.rocket-command.com

# Database Settings
DB_NAME=msp_dashboard
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://postgres:your-secure-database-password@db:5432/msp_dashboard

# Valkey Settings (Redis-compatible)
REDIS_URL=redis://valkey:6379/1
CELERY_BROKER_URL=redis://valkey:6379/0

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@rocket-command.com

# SSL Certificate Settings
CERTBOT_EMAIL=your-email@rocket-command.com

# Admin Settings
ADMIN_PASSWORD=your-secure-admin-password

# Application Settings
DJANGO_SETTINGS_MODULE=projectRocket.settings.production

# Security Settings (generate these with: python -c "import secrets; print(secrets.token_urlsafe(32))")
CSRF_SECRET_KEY=your-csrf-secret-key
SESSION_SECRET_KEY=your-session-secret-key

# Optional: External Services
# AWS_S3_ACCESS_KEY_ID=your-aws-access-key
# AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X 